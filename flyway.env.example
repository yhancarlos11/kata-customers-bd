# Copy this file to flyway.env (local use only, do not commit secrets)
# Use Neon DIRECT host URLs for migrations.

NEON_DEV_JDBC_URL=jdbc:postgresql://<direct-host-dev>/<db>?sslmode=require
NEON_DEV_DB_USER=<user>
NEON_DEV_DB_PASSWORD=<password>

NEON_PROD_JDBC_URL=jdbc:postgresql://<direct-host-prod>/<db>?sslmode=require
NEON_PROD_DB_USER=<user>
NEON_PROD_DB_PASSWORD=<password>
